Basic Syntax and Variables

#1. The program to display text.
print("Hello, World!")

#2. User Input: Capturing data from a user.
name = input("What is your name? ")
print(f"Hi, {name}!")

#3. Arithmetic: Basic math operations.
sum = 5 + 10    # Addition
power = 2 ** 3  # Exponentiation (8)
div = 17 // 3   # Floor division (5)

Control Flow

#4. If-Else Statement: Executing code based on conditions.
age = 20
if age >= 18:
    print("Adult")
else:
    print("Minor")

#5. For Loop: Iterating over a sequence.
for i in range(1, 6):
    print(f"Number {i}")

Data Structures

#6. Lists: Ordered, mutable collections.
fruits = ["apple", "banana", "cherry"]
fruits.append("orange")
print(fruits[0]) # Output: apple

#7. Dictionaries: Key-value pairs.
prices = {"apple": 0.40, "banana": 0.50}
print(prices["apple"])

