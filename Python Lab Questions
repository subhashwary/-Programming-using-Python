#Find the largest of three numbers
#Using the max() Function
def find_largest_max(num1, num2, num3):
  """Finds the largest of three numbers using the max() function."""
  largest = max(num1, num2, num3)
  return largest
# Example usage
a = 10
b = 45
c = 21
result = find_largest_max(a, b, c)
print(f"The largest number is: {result}")
# Output: The largest number is: 45

#Using if-elif-else Statements
def find_largest_conditional(num1, num2, num3):
  """Finds the largest of three numbers using if-elif-else statements."""
  if (num1 >= num2) and (num1 >= num3):
    largest = num1
  elif (num2 >= num1) and (num2 >= num3):
    largest = num2
  else:
    largest = num3
  return largest
# Example usage
a = 10
b = 45
c = 21
result = find_largest_conditional(a, b, c)
print(f"The largest number is: {result}")
# Output: The largest number is: 45

#Using a List and sort()
def find_largest_sort(num1, num2, num3):
  """Finds the largest of three numbers by sorting a list."""
  numbers = [num1, num2, num3]
  numbers.sort()
  largest = numbers[-1] # The last element is the largest after sorting
  return largest
# Example usage
a = 10
b = 45
c = 21
result = find_largest_sort(a, b, c)
print(f"The largest number is: {result}")
# Output: The largest number is: 45

#Given the principal amount, rate of interest, and number of years, calculate both simple interest and compound interest.
def calculate_simple_interest(principal, rate, years):
    """
    Calculates the Simple Interest (SI).
    Formula: SI = (P * R * T) / 100
    """
    simple_interest = (principal * rate * years) / 100
    return simple_interest
def calculate_compound_interest(principal, rate, years):
    """
    Calculates the Compound Interest (CI) and total amount.
    Formula for total amount: A = P * (1 + R/100)^T
    Formula for CI: CI = A - P
    """
    # Calculate the total amount using the compound interest formula
    amount = principal * (pow((1 + rate / 100), years))
    # Calculate the compound interest (Total Amount - Principal)
    compound_interest = amount - principal
    return compound_interest
def format_currency(amount):
    """Formats the amount to two decimal places."""
    return f"{amount:,.2f}"
# --- Example Usage ---
# Define the inputs
principal_amount = 10000  # P
interest_rate = 5        # R (as a percentage)
time_years = 3           # T
# Calculate the interests
si = calculate_simple_interest(principal_amount, interest_rate, time_years)
ci = calculate_compound_interest(principal_amount, interest_rate, time_years)
# Print the results
print(f"Principal Amount: ${format_currency(principal_amount)}")
print(f"Annual Interest Rate: {interest_rate}%")
print(f"Time Period: {time_years} years\n")
print(f"Simple Interest (SI): ${format_currency(si)}")
print(f"Compound Interest (CI): ${format_currency(ci)}")

#Find the GCD and LCM of two numbers
import math
def calculate_gcd_lcm(a, b):
    # Calculate GCD (Greatest Common Divisor)
    gcd_value = math.gcd(a, b)
    # Calculate LCM (Least Common Multiple)
    # The formula is: LCM(a, b) = (a * b) / GCD(a, b)
    lcm_value = abs(a*b) // math.gcd(a, b)
    return gcd_value, lcm_value
# Example usage
num1 = 56
num2 = 98
gcd, lcm = calculate_gcd_lcm(num1, num2)
print(f"The GCD of {num1} and {num2} is: {gcd}")
print(f"The LCM of {num1} and {num2} is: {lcm}")
#Output:
#The GCD of 56 and 98 is: 14
#The LCM of 56 and 98 is: 392

#Manually calculating GCD using the Euclidean Algorithm
def find_gcd(a, b):
    # Euclidean algorithm
    while b:
        a, b = b, a % b
    return a

def calculate_lcm_manual(a, b):
    # Formula: LCM(a, b) = (a * b) / GCD(a, b)
    # Use floor division (//) for integer results
    lcm = abs(a*b) // find_gcd(a, b)
    return lcm

# Example usage
num1 = 12
num2 = 18
gcd = find_gcd(num1, num2)
lcm = calculate_lcm_manual(num1, num2)
print(f"The GCD of {num1} and {num2} is: {gcd}")
print(f"The LCM of {num1} and {num2} is: {lcm}")
#Output:
#The GCD of 12 and 18 is: 6
#The LCM of 12 and 18 is: 36
